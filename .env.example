# Blocks search engines (robots.txt Disallow: / + a site-wide noindex meta
# tag) while true/unset. Set to "false" — and rebuild — only once the site
# is ready to go live and be indexed.
STAGING=true

# The Node app's own domain. Feeds canonical tags, sitemap.xml, robots.txt —
# and also which of www/non-www is canonical (src/middleware.ts 301s the
# other one to this host). Non-www here — www 301s to non-www. Changing
# this needs a rebuild, same as any other SITE_URL change (see
# DEPLOYMENT.md §6).
SITE_URL=https://airlineairportguide.com

# WordPress's REST API, on its own subdomain — a separate vhost from
# SITE_URL, fetched server-side only (never from the browser).
WP_API_URL=https://cms.airlineairportguide.com/wp-json/wp/v2

# AVIATIONSTACK_CACHE_TTL: user-initiated flight-number/airport-code
# searches (src/pages/api/flight-search.ts) — low volume, kept short.
# AVIATIONSTACK_BOARD_CACHE_TTL: the homepage welcome-section board
# (src/lib/aviationstack.ts getAirportBoard), which fetches automatically
# on every cold page load whether anyone searches or not. Keep this one
# long — AviationStack's free tier is 100 calls/*month* total, and a short
# TTL here burns through that from passive homepage traffic alone.
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_CACHE_TTL=120
AVIATIONSTACK_BOARD_CACHE_TTL=21600
PAGE_TREE_CACHE_TTL=30
SITE_TITLE=Airlines Locations

# Shared secret checked by src/pages/api/revalidate.ts against the
# X-Revalidate-Secret header. Must match the ASTRO_REVALIDATE_SECRET
# constant defined in WordPress's wp-config.php — see
# wordpress/rest-api-additions.php for the webhook that calls this route.
REVALIDATE_SECRET=
