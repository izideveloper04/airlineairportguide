---
// Hand-built landing page. SSR (prerender = false) so the directory data
// below never goes stale between deploys.
export const prerender = false;

import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedImage from "../components/FeaturedImage.astro";
import { getPageTree, getPosts, isChildTemplate } from "../lib/wp";
import heroImage from "../assets/images/guide-bg.webp";
import aboutImage from "../assets/images/guide-abt.webp";

// Unlike robots.txt/sitemap.xml/[...slug].astro, this page has no
// STAGING-dependent output to worry a CDN into caching stale (the noindex
// meta tag below is resolved live per-request too, since this route is SSR).
// Its only freshness constraint is the same TTL-cached page tree every
// content page already relies on (src/lib/wp.ts, PAGE_TREE_CACHE_TTL), so a
// short edge-cacheable window is safe: real caching benefit for traffic
// spikes, revalidated in the background rather than round-tripping to origin
// on every single request.
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=30, stale-while-revalidate=60");

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "AirlineAirportGuide",
  url: Astro.site?.toString(),
};

// One shared page-tree fetch, reused for "Latest Pages" below (both the list
// itself and each card's parent-title lookup). Each call degrades to an
// empty list/null on its own rather than failing the whole page - the
// homepage has its own standalone sections and shouldn't go down site-wide
// over a WordPress hiccup.
const [tree, latestPosts] = await Promise.all([
  getPageTree().catch(() => null),
  getPosts().catch(() => []),
]);

// Every *-child.php page sitewide, newest first - the naming convention
// shared with ChildPageLayout's sidebar (see src/lib/wp.ts). Each card also
// shows its parent page's title (e.g. the airline a location belongs to) as
// a listing-style category line, purely presentational - looked up from the
// already-fetched tree, no extra query.
const latestChildPages = tree
  ? tree.list.filter((p) => isChildTemplate(p.template)).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 16)
  : [];
const parentTitleOf = (parentId: number) => (tree ? tree.byId.get(parentId)?.title : undefined);

const newsItems = latestPosts.slice(0, 3);
const postDateFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });
---

<BaseLayout
  title="AirlineAirportGuide - Airport Terminals & Airline Information"
  description="Looking for an airline office? Search airline locations worldwide for office addresses, contact details, services, and other useful information."
  fullBleed
>
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} is:inline />

  <!-- ========================= HERO ========================== -->
  <section class="hero" style={`background-image:url(${heroImage.src})`}>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-text">
        <span class="hero-eyebrow">FROM CONCOURSE TO CURBSIDE</span>
        <h1>There’s More Beyond Your Flight</h1>
        <p>
          A closer look at the terminals, airlines, gates, facilities, and services that shape your journey from arrival to departure.
        </p>
      </div>

      <div class="hero-search-card">
        <h2>Find Your Terminal</h2>
        <form class="search-form" action="/airlines" method="get">
          <label for="hero-search-input" class="visually-hidden">Enter airport, city, airport code….</label>
          <div class="search-form__field">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" stroke-linecap="round" />
            </svg>
            <input id="hero-search-input" name="q" type="text" placeholder="Enter airline, city…" autocomplete="off" />
          </div>
          <button type="submit">Search</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ========================= USP / FEATURE CARDS ========================== -->
  <section class="usp-section">
    <div class="container">
      <div class="usp-grid">
        <div class="usp-card">
          <svg class="usp-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3Z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          <div class="usp-card-title">
            <h3>Reliable Airport Details</h3>
          </div>
          <p class="text-center">Access information on terminals, gates, facilities, and passenger services.</p>
        </div>
        <div class="usp-card">
          <svg class="usp-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.5 4 5.7 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.7-4-9s1.5-6.5 4-9Z" />
          </svg>
          <div class="usp-card-title">
            <h3>Worldwide Airport Coverage</h3>
          </div>
          <p class="text-center">Find airport and terminal information across major cities and destinations.</p>
        </div>
        <div class="usp-card">
          <svg class="usp-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" stroke-linecap="round" />
          </svg>
          <div class="usp-card-title">
            <h3>Easy Access to Information</h3>
          </div>
          <p class="text-center">Get straight to the relevant details, without useless data getting in the way.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Display latest pages -->
  <section class="latest-pages-section">
    <div class="container">
      <div class="section-heading">
        <span class="section-eyebrow">TERMINAL DIRECTORY</span>
        <h2>Airlines Across Airports</h2>
        <p>Browse airport listings with dedicated terminal details for cities around the world.</p>
      </div>
      {latestChildPages.length > 0 ? (
        <div class="pages-grid">
          {latestChildPages.map((page) => (
            <article class="page-card">
              <a href={`/${page.fullPath}`}>
                <div class="page-card-image">
                  <FeaturedImage src={page.featuredImage} alt={page.title} />
                </div>
                <div class="page-card-content">
                  <h3>{page.title}</h3>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-center" style="color:var(--muted)">No pages have been published yet.</p>
      )}
    </div>
  </section>

  <!-- ========================= ABOUT US ========================== -->
  <section class="about-section">
    <div class="container">
      <div class="about-grid">
        <div class="about-image">
          <Image
            src={aboutImage}
            alt="World map and travel planning"
            loading="lazy"
            draggable="false"
          />
        </div>
        <div class="about-content">
          <span class="section-eyebrow">About AirlineAirportGuide</span>
          <h2>Reference the Airport. Rely on the Details.</h2>
          <p>
            A flight confirmation tells you when to arrive. It doesn't always tell you what to expect once you get there. Knowing your airline's terminal, finding the right gate, or figuring out what's nearby can make a difference. AirlineAirportGuide brings together airport and terminal information, from airline locations and gates to facilities, services, and amenities.
          </p>
          <a href="#" class="btn btn-primary">Know More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Display latest blog -->
  <section class="latest-blog-section">
    <div class="container">
      <div class="section-heading">
        <span class="section-eyebrow">WORTH A READ</span>
        <h2>Featured Articles</h2>
        <p>Catch up on useful reads covering tips, insights, and trends shaping air travel.</p>
      </div>
      {newsItems.length > 0 ? (
        <div class="blog-grid">
          {newsItems.map((post) => (
            <article class="blog-card">
              <a href={`/blog/${post.slug}`}>
                <div class="blog-image">
                  <FeaturedImage src={post.featuredImage} />
                </div>
              </a>
              <div class="blog-content">
                <time datetime={post.date} class="blog-meta">{postDateFormatter.format(new Date(post.date))}</time>
                <h3>
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h3>
                <div set:html={post.excerpt} />
                <a href={`/blog/${post.slug}`} class="read-more">Read Article →</a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-center" style="color:#667085">No blog posts published yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
