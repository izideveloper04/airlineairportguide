---
// Individual blog post — sourced from WP posts (getPostBySlug), not the
// page hierarchy. Takes priority over [...slug].astro for anything under
// /blog/ since Astro matches this more specific route first.
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PostSidebar from "../../components/PostSidebar.astro";
import { getPostBySlug, getPosts, getSiteSettings, resolvePageMeta } from "../../lib/wp";
import FeaturedImage from "../../components/FeaturedImage.astro";

Astro.response.headers.set("Cache-Control", "no-store");

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : undefined;

if (!post) {
  return Astro.rewrite("/404");
}

const siteSettings = await getSiteSettings();
const meta = resolvePageMeta(post, siteSettings);

// Sidebar list of other posts — same "capped, newest first, excludes self"
// convention ChildPageLayout uses for its sibling-pages sidebar.
const allPosts = await getPosts();
const otherPosts = allPosts.filter((p) => p.slug !== post.slug).slice(0, 10);

const dateFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
  schema={meta.schema}
>
  <div class="page-hero">
    <div class="page-hero__main">
      <Breadcrumbs items={[{ label: "Blog", href: "/blog" }, { label: post.title }]} skipSchema />
      <h1 class="page-hero__title">{post.title}</h1>
      <time datetime={post.date} class="block text-sm text-ink/60 mt-2">
        {dateFormatter.format(new Date(post.date))}
      </time>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <article class="md:col-span-2">
      <FeaturedImage
        src={post.featuredImage}
        eager
        width={896}
        height={256}
        class="w-full h-64 object-cover rounded-md border border-[var(--line)] mb-6"
      />
      <div class="prose" set:html={post.content} />
    </article>
    <PostSidebar posts={otherPosts} />
  </div>

  <p class="mt-8"><a href="/blog" class="text-brand underline">← Back to Blog</a></p>
</BaseLayout>