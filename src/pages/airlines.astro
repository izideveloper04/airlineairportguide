---
// Hand-built directory page (not a single WP record) — lists every page
// using the parent-section template (page-templates/parent-page-template.php),
// regardless of where each one sits in the page tree — i.e. the top-level
// parent pages (airlines, in this site's content). getParentPages() matches
// by template, not by tree position, so this works the same whether or not
// a parent page itself has any ancestors. "airlines" is reserved in
// RESERVED_SLUGS (wp.ts) so a WP page can never shadow this route.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getParentPages } from "../lib/wp";

const airlines = await getParentPages();

// Backs the homepage hero's search box (GET /airlines?q=...) as well as an
// on-page search here — filtered server-side since the full list is
// already fetched, no separate search endpoint needed.
const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const results = query ? airlines.filter((page) => page.title.toLowerCase().includes(query.toLowerCase())) : airlines;

Astro.response.headers.set("Cache-Control", "no-store");
---

<BaseLayout title="Airlines | Airlines Locations" description="Airlines operating at Airlines Locations.">
  <div class="page-hero">
    <div class="page-hero__main">
      <Breadcrumbs items={[{ label: "Airlines" }]} />
      <h1 class="page-hero__title">Airlines</h1>
      <p class="text-sm text-ink/60 mt-2">
        {results.length} {results.length === 1 ? "airline" : "airlines"} listed{query && ` matching "${query}"`}.
      </p>
    </div>
  </div>

  <!-- Same search control as the homepage hero (.search-form, global.css) —
       one search affordance, styled identically wherever it appears. -->
  <form class="search-form mb-8" method="get">
    <label for="airlines-search-input" class="visually-hidden">Search airlines by name</label>
    <div class="search-form__field">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" /></svg>
      <input id="airlines-search-input" name="q" type="text" value={query} placeholder="Search airlines by name…" autocomplete="off" />
    </div>
    <button type="submit">Search</button>
  </form>

  {results.length > 0 ? (
    <div class="card-grid">
      {results.map((page) => (
        <a href={`/${page.fullPath}`} class="card">
          <div class="card__body">
            <p class="card__title">{page.title}</p>
          </div>
        </a>
      ))}
    </div>
  ) : query ? (
    <p class="text-ink/70">No airlines matching "{query}".</p>
  ) : (
    <p class="text-ink/70">No airlines listed yet.</p>
  )}
</BaseLayout>
