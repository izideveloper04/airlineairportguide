---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { isStaging } from "../lib/config";
import { getWpOrigin, type YoastHead } from "../lib/wp";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  /** Yoast's structured-data graph (see YoastHead.schema in src/lib/wp.ts) - rewritten to this site's origin and injected as JSON-LD below. */
  schema?: YoastHead["schema"];
  /** Escapes the default centered/padded <main> for edge-to-edge landing pages. */
  fullBleed?: boolean;
}

const { title, description, canonical, ogTitle, ogDescription, ogImage, schema, fullBleed = false } = Astro.props;

// Yoast generates the WebSite node's SearchAction assuming a normal
// (non-headless) WP front-end, where WordPress's own "?s=" query handles
// search - so it always points at "<site>/?s={search_term_string}". This
// site's actual search lives at /airlines?q=..., so that URL template is
// swapped for the real one below rather than left pointing at a page that
// silently ignores the query. (Only matters if Google ever surfaces this
// site via its sitelinks search box - a discretionary SERP feature - but
// it should point somewhere real either way.)
if (schema && Astro.site) {
  const searchUrl = `${new URL("/airlines", Astro.site)}?q={search_term_string}`;
  for (const node of schema["@graph"]) {
    if (node["@type"] !== "WebSite" || !Array.isArray(node.potentialAction)) continue;
    for (const action of node.potentialAction as Record<string, unknown>[]) {
      const target = action?.["@type"] === "SearchAction" ? (action.target as Record<string, unknown> | undefined) : undefined;
      if (target) target.urlTemplate = searchUrl;
    }
  }
}

// Every other @id/url in Yoast's graph points at the WP origin (cms.*)
// since that's what generated it - swapped for this site's own origin so
// the FAQPage/BreadcrumbList/etc. nodes describe this site, not the CMS.
// Media URLs are the one exception: images actually live on the WP origin
// (cms.*/wp-content/uploads/...), not this domain, so rewriting those too
// produces an ImageObject/thumbnailUrl that 404s here. Split-and-rejoin
// instead of a blanket replaceAll so each occurrence can be checked against
// what immediately follows it before deciding which origin to keep.
const wpOrigin = getWpOrigin();
const siteOrigin = Astro.site?.origin ?? "";
const schemaJson = schema
  ? JSON.stringify(schema)
      .split(wpOrigin)
      .reduce((acc, part) => (acc === null ? part : acc + (part.startsWith("/wp-content/uploads/") ? wpOrigin : siteOrigin) + part), null as string | null)
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="google-site-verification" content="FURR_C2ZAIkTC6s15wsjI5yxXoe6imHRfnDL6a5Z5aE" />
    {isStaging && <meta name="robots" content="noindex, nofollow" />}
    {!isStaging && (
      <>
        {/* Google tag (gtag.js) — gated on !isStaging like the noindex tag
            above, so local dev and pre-launch traffic never lands in GA4. */}
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-P01QR5QK05"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", "G-P01QR5QK05");
        </script>
      </>
    )}
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical ?? new URL(Astro.url.pathname, Astro.site).toString()} />

    <meta property="og:title" content={ogTitle ?? title} />
    {(ogDescription ?? description) && (
      <meta property="og:description" content={ogDescription ?? description} />
    )}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />

    <!-- Derived from the same OG fields above rather than a dedicated Yoast
         twitter_card field — kept to fields already verified present on this
         install so nothing here is guessed. -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={ogTitle ?? title} />
    {(ogDescription ?? description) && (
      <meta name="twitter:description" content={ogDescription ?? description} />
    )}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {schemaJson && <script type="application/ld+json" set:html={schemaJson} is:inline />}
  </head>
  <body class="min-h-screen flex flex-col bg-white text-ink font-sans antialiased">
    <Header />
    <main class="flex-1 w-full">
      <slot name="hero" />
      <div class={fullBleed ? undefined : "container py-8"}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
