---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RelatedPages from "../components/RelatedPages.astro";
import type { WPPage, Breadcrumb, ResolvedPageMeta } from "../lib/wp";
import { getChildren } from "../lib/wp";

interface Props {
  page: WPPage;
  ancestors: Breadcrumb[];
  meta: ResolvedPageMeta;
}

const { page, ancestors, meta } = Astro.props;
const children = await getChildren(page);

const breadcrumbItems = [
  ...ancestors.map((ancestor) => ({ label: ancestor.title, href: `/${ancestor.fullPath}` })),
  { label: page.title },
];

// A client-side text filter only earns its keep once there's enough to
// filter - below this, "search this section" would be a redundant control
// sitting above a handful of cards someone can already scan at a glance.
const SHOW_FILTER_THRESHOLD = 9;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
  schema={meta.schema}
>
  <!-- This template is a directory page, not a content page, so
       page.content is deliberately never rendered here. Children render as
       a card grid below, with no sidebar. -->
  <div class="page-hero">
    <div class="page-hero__main">
      <Breadcrumbs items={breadcrumbItems} skipSchema />
      <h1 class="page-hero__title">{page.title}</h1>
      {children.length > 0 && (
        <p class="text-sm text-ink/60 mt-2">
          {children.length} {children.length === 1 ? "page" : "pages"} listed under {page.title}.
        </p>
      )}
    </div>
  </div>

  {children.length >= SHOW_FILTER_THRESHOLD && (
    <div class="search-form mb-6">
      <div class="search-form__field">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" stroke-linecap="round" />
        </svg>
        <label for="dir-filter-input" class="visually-hidden">Filter {page.title} locations</label>
        <input id="dir-filter-input" type="text" data-dir-filter placeholder={`Filter ${children.length} locations…`} autocomplete="off" />
      </div>
    </div>
  )}

  <RelatedPages pages={children} />

  {children.length >= SHOW_FILTER_THRESHOLD && (
    <script>
      // Plain substring filter over the already-rendered card grid - the
      // full child list is already on the page (no separate fetch), so
      // hiding/showing existing .card elements is enough.
      //
      // Deliberately narrowed with `instanceof`, not a
      // `document.querySelector<T>(...)` generic-call or an `as` cast —
      // confirmed via the dev server that a <script> nested inside a
      // conditional template expression (this one's wrapped in
      // `{children.length >= SHOW_FILTER_THRESHOLD && (...)}`) is emitted
      // completely raw, unlike an unconditional component-level <script>
      // (e.g. Header.astro's), which Astro hoists into its own module and
      // strips TypeScript from before the browser ever sees it. This one
      // previously used `document.querySelector<HTMLInputElement>(...)`,
      // which the browser parsed as a (syntactically valid, semantically
      // wrong) chained comparison instead of a generic call, throwing
      // "input.addEventListener is not a function" at runtime — an `as`
      // cast is equally TS-only and would fail the same way. `instanceof`
      // is plain JS at runtime *and* narrows the type for `astro check`,
      // so it's the one form that satisfies both.
      const input = document.querySelector("[data-dir-filter]");
      const cards = document.querySelectorAll(".card[data-title]");

      if (input instanceof HTMLInputElement) {
        input.addEventListener("input", () => {
          const needle = input.value.trim().toLowerCase();
          cards.forEach((card) => {
            if (!(card instanceof HTMLElement)) return;
            const title = card.dataset.title ?? "";
            card.hidden = needle.length > 0 && !title.includes(needle);
          });
        });
      }
    </script>
  )}
</BaseLayout>
