---
import type { TocItem } from "../lib/toc";

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

{items.length > 1 && (
  <nav aria-label="Table of contents" class="side-nav">
    <h2 class="side-nav__title">Table of Contents</h2>
    <ul class="toc-nav__list">
      {items.map((item) => (
        <li>
          <a href={`#${item.id}`} class={item.level === 3 ? "toc-nav__link toc-nav__link--sub" : "toc-nav__link"}>
            {item.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
