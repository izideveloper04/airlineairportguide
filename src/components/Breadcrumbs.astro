---
// Generic — works for any page, not just the WP page tree (used by
// airlines.astro, blog.astro, blog/[slug].astro, and the three
// ParentPageLayout/ChildPageLayout/DefaultPageLayout templates). Emits both
// the visible trail and a BreadcrumbList JSON-LD block, since that's what
// actually earns the breadcrumb rich-snippet in Google search results —
// the visible <nav> alone doesn't.
export interface Crumb {
  label: string;
  /** Omit on the current/last page — it renders as plain text, not a link. */
  href?: string;
}

interface Props {
  /** The trail after Home - Home itself is prepended automatically below, so callers never include it. */
  items: Crumb[];
  /** Pages that pass a WordPress/Yoast `schema` graph to BaseLayout already
   *  ship their own BreadcrumbList JSON-LD there (correctly encoded, with
   *  its own URL convention) — this component's copy was a second,
   *  independently-generated BreadcrumbList competing with it (different
   *  root label, non-trailing-slash URLs, and a raw WP-title encoding bug
   *  in at least one sampled page). Pass true wherever a Yoast schema graph
   *  is already present so only one BreadcrumbList ships per page; leave it
   *  false on hand-built pages with no Yoast source (e.g. /airlines,
   *  /blog index) where this is the only breadcrumb schema available. */
  skipSchema?: boolean;
}

const { items: rest, skipSchema = false } = Astro.props;
const items: Crumb[] = [{ label: "AirlineAirportGuide", href: "/" }, ...rest];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site).toString() } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="text-sm text-ink/60 mb-4">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {item.href ? (
          <a href={item.href} class="hover:text-brands">{item.label}</a>
        ) : (
          <span aria-current="page" class="text-ink">{item.label}</span>
        )}
        {i < items.length - 1 && <span class="mx-1" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
{!skipSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />}
