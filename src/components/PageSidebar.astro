---
import type { WPPageSummary } from "../lib/wp";

interface Props {
  /** This child page's siblings, already filtered to *-child.php templates by the caller. */
  pages: WPPageSummary[];
}

const { pages } = Astro.props;
---

{pages.length > 0 && (
  <nav aria-label="Latest Pages" class="side-nav sticky top-20 self-start">
    <h2 class="side-nav__title">Latest Pages</h2>
    <ul class="side-nav__list">
      {pages.map((page) => (
        <li>
          <a href={`/${page.fullPath}`} class="side-nav__link">
            <span>{page.title}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
