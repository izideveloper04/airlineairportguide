---
import type { WPPageSummary } from "../lib/wp";
import FeaturedImage from "./FeaturedImage.astro";

interface Props {
  /** This parent page's direct children — rendered as a thumbnail + title card grid. */
  pages: WPPageSummary[];
}

const { pages } = Astro.props;
---

{pages.length > 0 ? (
  <div class="pages-grid">
    {pages.map((page) => (
      <article class="page-card" data-title={page.title.toLowerCase()}>
        <a href={`/${page.fullPath}`}>
          <div class="page-card-image">
            <FeaturedImage src={page.featuredImage} alt={page.title} />
          </div>
          <div class="page-card-content">
            <h3>{page.title}</h3>
          </div>
        </a>
      </article>
    ))}
  </div>
) : (
  <p class="text-ink/60 text-sm py-8 text-center">No pages have been published under this section yet.</p>
)}