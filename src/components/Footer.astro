---
import { Image } from "astro:assets";
import { navItems } from "../lib/navigation";
import logo from "../assets/images/logo/logo-airlineairportguide.png";

const year = new Date().getFullYear();
// Top-level nav items with a real destination — same restraint the header
// applies to placeholder/no-href items (see Header.astro), just without the
// submenu chrome a footer link list doesn't need.
const footerLinks = navItems.filter((item) => item.href && item.href !== "javascript:void(0)");
---

<footer class="mt-auto border-t border-[var(--line)] bg-[var(--surface)]">
  <div class="container py-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-sm">
    <div>
      <a href="/" class="inline-block">
        <Image src={logo} alt="AirlineAirportGuide" height={39} densities={[1, 2]} class="h-10 w-auto" />
      </a>
      <p class="text-ink/60 mt-3 max-w-xs leading-relaxed">
        Your dedicated resource for finding airline offices and discovering the contact details, services, and all relevant information that matter.
      </p>
    </div>

    <div>
      <h2 class="text-xs font-bold uppercase tracking-wide text-ink/50 mb-3">Explore</h2>
      <ul class="space-y-1.5">
        <li><a href="/turkish-airlines/turkish-airlines-newark-new-jersey" class="text-ink/70 hover:text-brand">Turkish Airlines Newark – New Jersey</a></li>
        <li><a href="/eva-air/eva-air-los-angeles" class="text-ink/70 hover:text-brand">EVA Air Los Angeles – California</a></li>
        <li><a href="/sun-country-airlines/sun-country-airlines-atlanta" class="text-ink/70 hover:text-brand">Sun Country Airlines Atlanta – Georgia</a></li>
        <li><a href="/eva-air/eva-air-seattle" class="text-ink/70 hover:text-brand">EVA Air Seattle – Washington</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-bold uppercase tracking-wide text-ink/50 mb-3">Top Pages</h2>
      <ul class="space-y-1.5">
        <li><a href="/caspian-airlines/caspian-airlines-abadan-iran" class="text-ink/70 hover:text-brand">Caspian Airlines Abadan Iran</a></li>
        <li><a href="/royal-jordanian-airlines/royal-jordanian-airlines-antalya-turkey" class="text-ink/70 hover:text-brand">Royal Jordanian Airlines Antalya</a></li>
        <li><a href="/caspian-airlines/caspian-airlines-ahvaz-iran" class="text-ink/70 hover:text-brand">Caspian Airlines Ahvaz Iran</a></li>
        <li><a href="/royal-jordanian-airlines/royal-jordanian-airlines-abu-dhabi" class="text-ink/70 hover:text-brand">Royal Jordanian Airlines Abu Dhabi</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-bold uppercase tracking-wide text-ink/50 mb-3">Popular Pages</h2>
      <ul class="space-y-1.5">
        <li><a href="/caspian-airlines/caspian-airlines-mashhad-iran" class="text-ink/70 hover:text-brand">Caspian Airlines Mashhad Iran</a></li>
        <li><a href="/turkish-airlines/turkish-airlines-atlanta-georgia" class="text-ink/70 hover:text-brand">Turkish Airlines Atlanta – Georgia</a></li>
        <li><a href="/lot-polish-airlines/lot-polish-airlines-chicago" class="text-ink/70 hover:text-brand">LOT Polish Airlines Chicago – Illinois</a></li>
        <li><a href="/caspian-airlines/caspian-airlines-tehran-iran" class="text-ink/70 hover:text-brand">Caspian Airlines Tehran Iran</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--line)]">
    <div class="container py-6 text-xs text-ink/60 leading-relaxed">
      <span class="font-semibold text-ink/70">Disclaimer:</span> AirlinesLocations is an independent information directory and is not affiliated with, endorsed by, or officially connected to any airline listed on this website. Airline names, trademarks, logos, and related information belong to their respective owners. The information provided is intended for general reference and may change without prior notice. 
    </div>
  </div>

  <div class="border-t border-[var(--line)]">
    <div class="container py-4 text-center text-xs text-ink/50">
      &copy; {year} Airlines Locations. All rights reserved.
    </div>
  </div>
</footer>
